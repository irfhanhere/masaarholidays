# Copy this file to .env.local and fill in the values from your Supabase
# project settings (Project Settings -> API). Never commit .env.local —
# it is already covered by .gitignore.

# Public — safe to expose to the browser (anon key is subject to Row Level
# Security policies, see supabase/migrations/0001_init.sql).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — NEVER prefix with NEXT_PUBLIC_, never import from a "use
# client" file. Used only in admin server actions / route handlers that
# must bypass RLS (e.g. the daily currency-rate refresh, admin user
# management).
SUPABASE_SERVICE_ROLE_KEY=

# Used to build absolute URLs (metadata, sitemap, OG tags).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Protects /api/cron/publish-scheduled-posts (auto-publishes scheduled blog
# posts, see vercel.json) — Vercel sends this automatically as a Bearer
# token to routes listed under "crons" once set in Project Settings ->
# Environment Variables. Optional locally; the route allows unauthenticated
# calls when this is unset, so you can test it directly in dev.
CRON_SECRET=

# GA4 measurement ID from Google Analytics (Admin -> Data Streams -> your
# web stream). Public site only — see app/layout.tsx. Leave unset locally
# to skip loading gtag.js in dev.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# SMTP credentials for sending quotations/invoices/receipts/vouchers by
# email (lib/documents/mailer.ts) — use an existing Masaar mailbox (e.g.
# care@masaarholidays.com)'s SMTP details, not a new third-party account.
# Leave unset to skip email sending; Download PDF and WhatsApp sharing work
# without these.
# Hostinger SMTP Configuration
# Use Hostinger SSL/TLS settings for care@masaarholidays.com
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=care@masaarholidays.com
SMTP_PASS=
MAIL_FROM_EMAIL=care@masaarholidays.com
MAIL_FROM_NAME=Masaar Holidays
SMTP_FROM=Masaar Holidays <care@masaarholidays.com>

# MegaEsim Reseller API (eSIM store)
# Server-only: Never prefix with NEXT_PUBLIC_, never import client-side.
MEGAESIM_API_KEY=
MEGAESIM_BASE_URL=https://megaesim.com/api/v1/partner
MEGAESIM_WEBHOOK_SECRET=
ESIM_SYNC_SECRET=
ESIM_MARKUP_PCT=0

# Stripe Payments (eSIM online checkout)
# Server-only: Never prefix with NEXT_PUBLIC_, never import client-side.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Staff alerts for provisioning failures and low wallet balance
# Server-only: Never prefix with NEXT_PUBLIC_, never import client-side.
STAFF_ALERT_EMAIL=care@masaarholidays.com

# UAE Value Added Tax (VAT) for eSIM
# When enabled (true), prices are treated as VAT-inclusive. Leave false by default.
ESIM_VAT_ENABLED=false
ESIM_VAT_PCT=5
VAT_TRN=

# eSIM Launch Mode Flag (off | preview | live, default: off)
# off: hidden from nav, footer, sitemap; noindex; 404 on /esim and /esim/checkout unless preview cookie is set.
# preview: set preview cookie via /esim?preview=<ESIM_PREVIEW_KEY> (7-day httpOnly) for staff testing on domain.
# live: fully public, visible in nav/footer/sitemap, indexable.
ESIM_LAUNCH_MODE=live
ESIM_PREVIEW_KEY=masaar_preview_2026_test


# eSIM Exchange Rates (FX) Configuration
# Server-only: Never prefix with NEXT_PUBLIC_, never import client-side.
# Pegged rates: AED (default 3.6725) and SAR (default 3.75).
# Buffer: Percentage buffer applied only to floating currencies (EUR, GBP, INR) to cover conversion drift.
ESIM_FX_AED_RATE=3.6725
ESIM_FX_SAR_RATE=3.75
ESIM_FX_BUFFER_PCT=2
CRON_SECRET=


