# Copy this file to .env.local and fill in the values from your Supabase
# project settings (Project Settings -> API). Never commit .env.local —
# it is already covered by .gitignore.

# Public — safe to expose to the browser (anon key is subject to Row Level
# Security policies, see supabase/migrations/0001_init.sql).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — NEVER prefix with NEXT_PUBLIC_, never import from a "use
# client" file. Used only in admin server actions / route handlers that
# must bypass RLS (e.g. the daily currency-rate refresh, admin user
# management).
SUPABASE_SERVICE_ROLE_KEY=

# Used to build absolute URLs (metadata, sitemap, OG tags).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Protects /api/cron/publish-scheduled-posts (auto-publishes scheduled blog
# posts, see vercel.json) — Vercel sends this automatically as a Bearer
# token to routes listed under "crons" once set in Project Settings ->
# Environment Variables. Optional locally; the route allows unauthenticated
# calls when this is unset, so you can test it directly in dev.
CRON_SECRET=

# GA4 measurement ID from Google Analytics (Admin -> Data Streams -> your
# web stream). Public site only — see app/layout.tsx. Leave unset locally
# to skip loading gtag.js in dev.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# SMTP credentials for sending quotations/invoices/receipts/vouchers by
# email (lib/documents/mailer.ts) — use an existing Masaar mailbox (e.g.
# care@masaarholidays.com)'s SMTP details, not a new third-party account.
# Leave unset to skip email sending; Download PDF and WhatsApp sharing work
# without these.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
