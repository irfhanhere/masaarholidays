# MegaEsim Reseller API (eSIM store)
# Server-only: Never prefix with NEXT_PUBLIC_, never import client-side.
MEGAESIM_API_KEY=
MEGAESIM_BASE_URL=https://megaesim.com/api/v1/partner
MEGAESIM_WEBHOOK_SECRET=
ESIM_SYNC_SECRET=
ESIM_MARKUP_PCT=0

# Stripe Payments (eSIM online checkout)
# Server-only: Never prefix with NEXT_PUBLIC_, never import client-side.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Staff alerts for provisioning failures and low wallet balance
# Server-only: Never prefix with NEXT_PUBLIC_, never import client-side.
STAFF_ALERT_EMAIL=care@masaarholidays.com

# UAE Value Added Tax (VAT) for eSIM
# When enabled (true), prices are treated as VAT-inclusive. Leave false by default.
ESIM_VAT_ENABLED=false
ESIM_VAT_PCT=5
VAT_TRN=

# eSIM Launch Mode Flag (off | preview | live, default: off)
# off: hidden from nav, footer, sitemap; noindex; 404 on /esim and /esim/checkout unless preview cookie is set.
# preview: set preview cookie via /esim?preview=<ESIM_PREVIEW_KEY> (7-day httpOnly) for staff testing on domain.
# live: fully public, visible in nav/footer/sitemap, indexable.
ESIM_LAUNCH_MODE=live
ESIM_PREVIEW_KEY=masaar_preview_2026_test

# eSIM Exchange Rates (FX) Configuration
# Server-only: Never prefix with NEXT_PUBLIC_, never import client-side.
# Pegged rates: AED (default 3.6725) and SAR (default 3.75).
# Buffer: Percentage buffer applied only to floating currencies (EUR, GBP, INR) to cover conversion drift.
ESIM_FX_AED_RATE=3.6725
ESIM_FX_SAR_RATE=3.75
ESIM_FX_BUFFER_PCT=2
CRON_SECRET=


